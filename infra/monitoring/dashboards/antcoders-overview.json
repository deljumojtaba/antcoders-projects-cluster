   "title": "Servers",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 17,
   "title": "CPU used by server",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 18,
   "title": "Memory used by server",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 8,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 19,
   "title": "Disk used by server",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 16,
    "y": 31,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * on(instance) group_left(nodename) node_uname_info",
     "legendFormat": "{{nodename}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 20,
   "type": "row",
   "title": "Databases",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 21,
   "title": "Replication lag",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (pod) (cnpg_pg_replication_lag)",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "How far each replica is behind its primary. Should stay near 0."
  },
  {
   "id": 22,
   "title": "Hours since last full backup (R2)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 8,
    "y": 39,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(time() - max by (namespace) (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp > 0)) / 3600",
     "legendFormat": "{{namespace}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 26
       },
       {
        "color": "red",
        "value": 50
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "description": "Nightly full backups run at 03:00 (game) and 03:30 (data) UTC. Over 26 h means one was missed."
  },
  {
   "id": 24,
   "title": "Minutes since last WAL archived (R2)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 39,
    "w": 4,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min by (namespace) (cnpg_pg_stat_archiver_seconds_since_last_archival) / 60",
     "legendFormat": "{{namespace}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 180
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "description": "Continuous backup: every change is shipped to R2 as WAL. Rises only when a database is idle; stuck high while the app is busy means archiving is broken."
  },
  {
   "id": 23,
   "title": "Database size",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 16,
    "y": 39,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (datname) (cnpg_pg_database_size_bytes{datname!~\"postgres|template.*\"})",
     "legendFormat": "{{datname}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
