{
 "uid": "antcoders-overview",
 "title": "Antcoders overview",
 "tags": [
  "antcoders"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "At a glance",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Players online (Kelime Sava\u015f\u0131)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kelime_ws_connections_active) or vector(0)",
     "legendFormat": "players",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "title": "Requests / second (all sites)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(traefik_router_requests_total[5m]))",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "title": "404s in the last 24 h",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(traefik_router_requests_total{code=\"404\"}[24h]))",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 100
       },
       {
        "color": "red",
        "value": 1000
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "description": "Not-found responses across all sites. See the table below for which site."
  },
  {
   "id": 5,
   "title": "5xx errors in the last 1 h",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(traefik_router_requests_total{code=~\"5..\"}[1h])) or vector(0)",
     "legendFormat": "__auto",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 20
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   }
  },
  {
   "id": 6,
   "type": "row",
   "title": "Sites",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 7,
   "title": "Requests / second by site",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (label_replace(rate(traefik_router_requests_total[5m]), \"site\", \"$1\", \"router\", \"[a-z]+-(.+)-[0-9a-f]{20}@kubernetescrd\"))",
     "legendFormat": "{{site}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "title": "Response time p95 by site",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, site) (label_replace(rate(traefik_router_request_duration_seconds_bucket[5m]), \"site\", \"$1\", \"router\", \"[a-z]+-(.+)-[0-9a-f]{20}@kubernetescrd\")))",
     "legendFormat": "{{site}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "95% of requests are faster than this. Target: under 0.2 s."
  },
  {
   "id": 9,
   "title": "404s by site (per minute)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (site) (label_replace(rate(traefik_router_requests_total{code=\"404\"}[5m]), \"site\", \"$1\", \"router\", \"[a-z]+-(.+)-[0-9a-f]{20}@kubernetescrd\")) * 60",
     "legendFormat": "{{site}}",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "title": "404s by site, last 24 h",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(sum by (site) (label_replace(increase(traefik_router_requests_total{code=\"404\"}[24h]), \"site\", \"$1\", \"router\", \"[a-z]+-(.+)-[0-9a-f]{20}@kubernetescrd\")))",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "404s"
      }
     }
    }
   ]
  },
  {
